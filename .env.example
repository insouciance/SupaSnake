# SupaSnake - Environment Variables
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to git - it's in .gitignore.
# Production values live in Vercel project settings, not in files.

# ==============================================================================
# SUPABASE (Database + Auth)  - dedicated "supasnake" project
# ==============================================================================

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
DATABASE_URL=postgresql://postgres:[password]@db.your-project.supabase.co:5432/postgres

# ==============================================================================
# STRIPE  - DEDICATED SupaSnake account (never the Court OS account!)
# ==============================================================================

NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxxx
STRIPE_SECRET_KEY=sk_test_xxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxx

# Price IDs (create products in the SupaSnake Stripe dashboard first).
#
# There are NO one-time price IDs. WP-0.09 deleted the energy and bundle SKUs
# (Constitution §10.4 — energy, DNA and variants are never sold), so
# NEXT_PUBLIC_STRIPE_ENERGY_SMALL / _MEDIUM / _LARGE,
# NEXT_PUBLIC_STRIPE_STARTER_BUNDLE and NEXT_PUBLIC_STRIPE_DYNASTY_BUNDLE are
# gone from this file and from the required set. Deployments that still define
# them keep building — the validator tolerates the leftovers and warns once
# (scripts/production-env-validation.cjs). The Atelier (§10.2) will introduce
# new one-time price IDs when it ships; it will not reuse these.

# SupaSnake Premium (recurring EUR prices, tax_behavior=inclusive;
# enable Stripe Tax + the Customer Portal with cancellation allowed)
NEXT_PUBLIC_STRIPE_PREMIUM_MONTHLY=price_xxxx
NEXT_PUBLIC_STRIPE_PREMIUM_YEARLY=price_xxxx

# ==============================================================================
# SENTRY (Error tracking)
# ==============================================================================

NEXT_PUBLIC_SENTRY_DSN=https://xxxxx@xxxxx.ingest.sentry.io/xxxxx
SENTRY_AUTH_TOKEN=your-auth-token
SENTRY_ORG=your-org
SENTRY_PROJECT=supasnake

# ==============================================================================
# POSTHOG (Analytics + feature flags + session replay)
# ==============================================================================

NEXT_PUBLIC_POSTHOG_KEY=phc_xxxx
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# ==============================================================================
# EMAIL (Resend)
# Auth emails: configure Resend SMTP in Supabase Dashboard -> Auth -> SMTP
# (no env var needed for that). The API key drives the opt-in Analyst weekly
# digest and the Dispatch double-opt-in confirmation mail. Without it the
# waitlist still records a PENDING row and simply never confirms it - no
# address becomes mailable, which is the safe failure.
# ==============================================================================

# RESEND_API_KEY=re_xxxx

# ==============================================================================
# APPLICATION
# ==============================================================================

NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional server-side clan tuning. Omit for the reviewed launch defaults.
# Founding is always quoted before confirmation and atomically spends the
# server value; changing it makes an already-open quote stale and safely
# rejected. Glory and battle rewards are independently bounded in application
# config and SQL and never multiply battle score, run Yield, or Energy.
# CLAN_FOUNDING_DNA_COST=500
# CLAN_INVITATION_LIFETIME_SECONDS=604800
# CLAN_BATTLE_PARTICIPATION_DNA=100
# CLAN_BATTLE_VICTOR_BONUS_DNA=100
# CLAN_BATTLE_STALEMATE_BONUS_DNA=50
# CLAN_GLORY_REWARD_DNA=250
# CLAN_GLORY_MIN_TENURE_SECONDS=604800
# CLAN_GLORY_MIN_CONTRIBUTION_DEPTH=1
# CLAN_GLORY_ALLOW_SELF_AWARD=false
# CLAN_GLORY_ALLOW_PENDING_REASSIGNMENT=false

# FTUE v2 player-flow rollout. Opt in only after migration 037 is applied;
# omit or set false to retain the rollback onboarding path.
NEXT_PUBLIC_FTUE_V2=true

# Run Cockpit & Arena. This is the current production experience; set false
# only when deliberately exercising the coherent rollback HUD.
NEXT_PUBLIC_HUD_COCKPIT_V1=true

# Tactical Genome v2. Exact true issues v2 run authority and exposes the v2
# Research model; false keeps new starts on Genome v1 while already-stamped v2
# runs remain resumable and settle under their immutable rules version.
NEXT_PUBLIC_GENOME_V2=true

# Growth surfaces v1 (WP-0.08): the landing page's below-the-fold pitch, the
# /play intent page, and the Dispatch waitlist. Defaulted OFF - omit it or set
# anything but the exact string "true" and none of those surfaces exist
# (/play and /dispatch/* return 404, the waitlist API returns 404). SEO
# metadata, icons, OG images, robots.txt, sitemap.xml, the share-card URL and
# the funnel taxonomy are NOT gated by this flag; they ship unconditionally.
# NEXT_PUBLIC_GROWTH_SURFACES_V1=true

# The player's contract page (WP-2.03, Constitution §3, §11.6): /contract, the
# manifesto at a linkable URL - nine clauses, each with the question you check
# it with. Defaulted OFF - omit it or set anything but the exact string "true"
# and /contract returns 404 and sitemap.xml does not list it. The Open Graph
# card at /contract/opengraph-image is deliberately NOT gated: an image is not
# a player surface, and a card that renders while the page is dark beats a
# card that breaks the day the flag flips.
# NEXT_PUBLIC_PLAYER_CONTRACT_V1=true

# The World Serpent (WP-1.01, Constitution §7.3): the weekly hunt, Depth, and
# the Sunday settlement. Defaulted OFF until the Phase 1 gate - omit it or set
# anything but the exact string "true" and the Serpent does not exist: no week
# is resolved, `mode: 'serpent'` is an ordinary charged run, and
# GET /api/serpent/panel answers `live: false`. Opt in only after migration
# 046 is applied. The settlement cron (/api/ops/serpent-settlement, Mondays
# 00:20 UTC) runs regardless and settles nothing while no week has been hunted
# - Depth already earned is never stranded by the flag (Rule 6).
# NEXT_PUBLIC_SERPENT_V1=true

# The settlement dispatch (WP-1.09, Constitution §7.6, §11.6): the weekly
# Serpent settlement auto-composed into a post the operator presses publish
# on, and the DETERMINISTIC weekly settlement email (LLM narration retired -
# nothing on this path calls a model). Defaulted OFF - omit it or set
# anything but the exact string "true" and the publish card does not render
# on /serpent, and GET /api/ops/settlement-dispatch composes nothing, reads
# nothing and sends nothing.
#
# Turning it on is NOT sufficient to send: the email also needs RESEND_API_KEY
# and migration 051 (settlement_dispatch_sends). Without the ledger the route
# fails closed and mails nobody, because a cron replay with no claimed row
# would mail somebody twice. The email is opt-in only, in two independent
# senses - a Dispatch address must have completed double opt-in, a player must
# have set email_digest_opt_in AND hold a confirmed, non-anonymous address.
# NEXT_PUBLIC_SETTLEMENT_DISPATCH_V1=true

# Run Flow v1 (WP-1.06, Constitution §5): the consolidated Run Setup page and
# the cockpit Setup and three-layer Victory Lap. Production is compiled with
# the exact string "true" and the health contract proves that the released
# artifact contains it. Omit it locally only to inspect the rollback surface.
# With it on: LAUNCH opens Run Setup instead of handing off a prepared run
# (open -> LAUNCH -> START -> board, <=3 taps); Results is three layers with
# one recommended next action and no commerce; REPLAY re-enters the same
# configuration (<=2 taps). No migration and no server change - the flag moves
# surfaces only, so rolling it back cannot strand data.
NEXT_PUBLIC_RUN_FLOW_V1=true

# Career Spine presentation (Career Pulse, snake passports, run recognition,
# and server-backed milestone attention). Settlement/progress remain active
# when this is off; the flag is a presentation-only rollback boundary.
# NEXT_PUBLIC_CAREER_SPINE_V1=true

# Ascension (WP-2.01, Constitution §6.1, §12.2): "Score, this month" - the
# Signal's MONTHLY AGGREGATION VIEW, not a surface. League points are the sum
# of your best ten daily Signal scores in the calendar month, read on
# /leaderboard?month=YYYY-MM. Defaulted OFF - omit it or set anything but the
# exact string "true" and the month block does not render, GET
# /api/signal/ascension answers `live: false`, and nothing else in the game
# changes.
#
# NO MIGRATION AND NO WRITE. Ascension folds rows migration 049 already stores
# (signal_objective_runs x signal_days x game_sessions.score); it has no table,
# no RPC, no settlement, no cycle to close and no reward to grant. So this flag
# can be flipped in either direction at any moment without stranding anything -
# there is nothing to strand. Requires migration 049 for a non-empty reading;
# without it the route reports `live: false` rather than erroring.
# NEXT_PUBLIC_ASCENSION_V1=true

# The D2 difficulty ladder (WP-3.12). Dark by default.
#
# Gates the Run Setup RUNG SELECTOR and the session route's willingness to
# honour a rung a client asks for. It does NOT gate the ladder's math: the rung
# is resolved server-side at run start, stamped into `game_sessions.run_context`
# and replayed from that stamp at settlement, exactly as the growth profile is.
# With this off the server never stamps a rung, every run is rung 0, and rung 0
# is byte-identical to the shipped game — on the client and on the server.
#
# The always-visible rung READOUT on Run Setup is deliberately NOT gated. A
# readout that disappears with its flag cannot tell you the flag is off, which
# is the failure this wave has already paid for twice.
#
# SECOND, INDEPENDENT CONDITION: migration 057 (`player_ladders`). Until it is
# applied the server cannot know which rungs a player has unlocked, so it offers
# none and stamps none — the ladder stays dark even with this flag on. Turning
# the flag on ahead of the migration is therefore safe and does nothing.
# NEXT_PUBLIC_LADDER_V1=true

# Age gate (the source of truth is MINIMUM_AGE in src/shared/config/legal.ts)
MIN_AGE_REQUIREMENT=14

# ==============================================================================
# DISCORD (Identity v1 section 8 - clan communities + Linked Roles)
# App + bot from the Discord developer portal; the bot must be in the
# official guild with Manage Channels/Roles/Webhooks + Create Instant
# Invite, and the server widget enabled.
# ==============================================================================

DISCORD_CLIENT_ID=your-discord-application-id
DISCORD_CLIENT_SECRET=your-discord-oauth-secret
DISCORD_BOT_TOKEN=your-discord-bot-token
DISCORD_GUILD_ID=official-supasnake-guild-id
DISCORD_REDIRECT_URI=https://supasnake.com/api/discord/callback
DISCORD_REDIRECT_URI_LOCAL=http://localhost:3000/api/discord/callback
# 32 bytes base64 (openssl rand -base64 32) - AES-256-GCM key for stored
# Discord tokens + the OAuth state HMAC subkey. Rotating it orphans
# stored grants (players just re-link).
DISCORD_TOKEN_ENC_KEY=base64-32-byte-key
# Protects /api/discord/dispatch and /api/analyst/cron (Vercel sends it
# as a Bearer token)
CRON_SECRET=random-secret

# ==============================================================================
# THE ANALYST (Identity v1 section 9 - OpenAI narration over
# deterministic facts). Everything degrades to the templated fallback:
# no key, kill switch off, or budget spent all render the same artifacts
# from the same fact sheets.
# ==============================================================================

OPENAI_API_KEY=sk-your-openai-key
# Kill switch. Unset = enabled whenever OPENAI_API_KEY is present.
ANALYST_ENABLED=true
# Daily token circuit breaker (input+output, all artifacts).
# Unset = 2000000.
ANALYST_DAILY_TOKEN_BUDGET=2000000
