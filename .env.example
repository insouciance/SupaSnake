# SupaSnake - Environment Variables
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to git - it's in .gitignore.
# Production values live in Vercel project settings, not in files.

# ==============================================================================
# SUPABASE (Database + Auth)  - dedicated "supasnake" project
# ==============================================================================

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
DATABASE_URL=postgresql://postgres:[password]@db.your-project.supabase.co:5432/postgres

# ==============================================================================
# STRIPE  - DEDICATED SupaSnake account (never the Court OS account!)
# ==============================================================================

NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxxx
STRIPE_SECRET_KEY=sk_test_xxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxx

# Price IDs (create products in the SupaSnake Stripe dashboard first).
#
# There are NO one-time price IDs. WP-0.09 deleted the energy and bundle SKUs
# (Constitution §10.4 — energy, DNA and variants are never sold), so
# NEXT_PUBLIC_STRIPE_ENERGY_SMALL / _MEDIUM / _LARGE,
# NEXT_PUBLIC_STRIPE_STARTER_BUNDLE and NEXT_PUBLIC_STRIPE_DYNASTY_BUNDLE are
# gone from this file and from the required set. Deployments that still define
# them keep building — the validator tolerates the leftovers and warns once
# (scripts/production-env-validation.cjs). The Atelier (§10.2) will introduce
# new one-time price IDs when it ships; it will not reuse these.

# SupaSnake Premium (recurring EUR prices, tax_behavior=inclusive;
# enable Stripe Tax + the Customer Portal with cancellation allowed)
NEXT_PUBLIC_STRIPE_PREMIUM_MONTHLY=price_xxxx
NEXT_PUBLIC_STRIPE_PREMIUM_YEARLY=price_xxxx

# ==============================================================================
# SENTRY (Error tracking)
# ==============================================================================

NEXT_PUBLIC_SENTRY_DSN=https://xxxxx@xxxxx.ingest.sentry.io/xxxxx
SENTRY_AUTH_TOKEN=your-auth-token
SENTRY_ORG=your-org
SENTRY_PROJECT=supasnake

# ==============================================================================
# POSTHOG (Analytics + feature flags + session replay)
# ==============================================================================

NEXT_PUBLIC_POSTHOG_KEY=phc_xxxx
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# ==============================================================================
# EMAIL (Resend)
# Auth emails: configure Resend SMTP in Supabase Dashboard -> Auth -> SMTP
# (no env var needed for that). The API key drives the opt-in Analyst weekly
# digest and the Dispatch double-opt-in confirmation mail. Without it the
# waitlist still records a PENDING row and simply never confirms it - no
# address becomes mailable, which is the safe failure.
# ==============================================================================

# RESEND_API_KEY=re_xxxx

# ==============================================================================
# APPLICATION
# ==============================================================================

NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# FTUE v2 player-flow rollout. Opt in only after migration 037 is applied;
# omit or set false to retain the rollback onboarding path.
NEXT_PUBLIC_FTUE_V2=true

# Run Cockpit & Arena. This is the current production experience; set false
# only when deliberately exercising the coherent rollback HUD.
NEXT_PUBLIC_HUD_COCKPIT_V1=true

# Growth surfaces v1 (WP-0.08): the landing page's below-the-fold pitch, the
# /play intent page, and the Dispatch waitlist. Defaulted OFF - omit it or set
# anything but the exact string "true" and none of those surfaces exist
# (/play and /dispatch/* return 404, the waitlist API returns 404). SEO
# metadata, icons, OG images, robots.txt, sitemap.xml, the share-card URL and
# the funnel taxonomy are NOT gated by this flag; they ship unconditionally.
# NEXT_PUBLIC_GROWTH_SURFACES_V1=true

# The World Serpent (WP-1.01, Constitution §7.3): the weekly hunt, Depth, and
# the Sunday settlement. Defaulted OFF until the Phase 1 gate - omit it or set
# anything but the exact string "true" and the Serpent does not exist: no week
# is resolved, `mode: 'serpent'` is an ordinary charged run, and
# GET /api/serpent/panel answers `live: false`. Opt in only after migration
# 046 is applied. The settlement cron (/api/ops/serpent-settlement, Mondays
# 00:20 UTC) runs regardless and settles nothing while no week has been hunted
# - Depth already earned is never stranded by the flag (Rule 6).
# NEXT_PUBLIC_SERPENT_V1=true

# Run Flow v1 (WP-1.06, Constitution §5): the consolidated Run Setup page and
# the three-layer Results screen. Defaulted OFF - omit it or set anything but
# the exact string "true" and the shipped pre-run/game-over screen renders
# exactly as it does today, including its run-end toasts and notifications.
# With it on: LAUNCH opens Run Setup instead of handing off a prepared run
# (open -> LAUNCH -> START -> board, <=3 taps); Results is three layers with
# one recommended next action and no commerce; REPLAY re-enters the same
# configuration (<=2 taps). No migration and no server change - the flag moves
# surfaces only, so rolling it back cannot strand data.
# NEXT_PUBLIC_RUN_FLOW_V1=true

# Age gate (the source of truth is MINIMUM_AGE in src/shared/config/legal.ts)
MIN_AGE_REQUIREMENT=14

# ==============================================================================
# DISCORD (Identity v1 section 8 - clan communities + Linked Roles)
# App + bot from the Discord developer portal; the bot must be in the
# official guild with Manage Channels/Roles/Webhooks + Create Instant
# Invite, and the server widget enabled.
# ==============================================================================

DISCORD_CLIENT_ID=your-discord-application-id
DISCORD_CLIENT_SECRET=your-discord-oauth-secret
DISCORD_BOT_TOKEN=your-discord-bot-token
DISCORD_GUILD_ID=official-supasnake-guild-id
DISCORD_REDIRECT_URI=https://supasnake.com/api/discord/callback
DISCORD_REDIRECT_URI_LOCAL=http://localhost:3000/api/discord/callback
# 32 bytes base64 (openssl rand -base64 32) - AES-256-GCM key for stored
# Discord tokens + the OAuth state HMAC subkey. Rotating it orphans
# stored grants (players just re-link).
DISCORD_TOKEN_ENC_KEY=base64-32-byte-key
# Protects /api/discord/dispatch and /api/analyst/cron (Vercel sends it
# as a Bearer token)
CRON_SECRET=random-secret

# ==============================================================================
# THE ANALYST (Identity v1 section 9 - OpenAI narration over
# deterministic facts). Everything degrades to the templated fallback:
# no key, kill switch off, or budget spent all render the same artifacts
# from the same fact sheets.
# ==============================================================================

OPENAI_API_KEY=sk-your-openai-key
# Kill switch. Unset = enabled whenever OPENAI_API_KEY is present.
ANALYST_ENABLED=true
# Daily token circuit breaker (input+output, all artifacts).
# Unset = 2000000.
ANALYST_DAILY_TOKEN_BUDGET=2000000
