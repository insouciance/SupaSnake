# SupaSnake - Environment Variables
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to git - it's in .gitignore.
# Production values live in Vercel project settings, not in files.

# ==============================================================================
# SUPABASE (Database + Auth)  - dedicated "supasnake" project
# ==============================================================================

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
DATABASE_URL=postgresql://postgres:[password]@db.your-project.supabase.co:5432/postgres

# ==============================================================================
# STRIPE  - DEDICATED SupaSnake account (never the Court OS account!)
# ==============================================================================

NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxxx
STRIPE_SECRET_KEY=sk_test_xxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxx

# Price IDs (create products in the SupaSnake Stripe dashboard first)
NEXT_PUBLIC_STRIPE_ENERGY_SMALL=price_xxxx
NEXT_PUBLIC_STRIPE_ENERGY_MEDIUM=price_xxxx
NEXT_PUBLIC_STRIPE_ENERGY_LARGE=price_xxxx
NEXT_PUBLIC_STRIPE_STARTER_BUNDLE=price_xxxx
NEXT_PUBLIC_STRIPE_DYNASTY_BUNDLE=price_xxxx

# ==============================================================================
# SENTRY (Error tracking)
# ==============================================================================

NEXT_PUBLIC_SENTRY_DSN=https://xxxxx@xxxxx.ingest.sentry.io/xxxxx
SENTRY_AUTH_TOKEN=your-auth-token
SENTRY_ORG=your-org
SENTRY_PROJECT=supasnake

# ==============================================================================
# POSTHOG (Analytics + feature flags + session replay)
# ==============================================================================

NEXT_PUBLIC_POSTHOG_KEY=phc_xxxx
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# ==============================================================================
# EMAIL (Resend)
# Auth emails: configure Resend SMTP in Supabase Dashboard -> Auth -> SMTP
# (no env var needed for that). API key only for future transactional email.
# ==============================================================================

# RESEND_API_KEY=re_xxxx

# ==============================================================================
# APPLICATION
# ==============================================================================

NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Age gate
MIN_AGE_REQUIREMENT=13
